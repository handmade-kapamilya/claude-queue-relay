{
  "name": "claude-tab-queue",
  "displayName": "Claude Tab Queue",
  "description": "A queue for many Claude Code tabs: pings and pins a tab when it finishes or needs you, one board (sidebar or pop-out) with lane-aware tabs, relay lanes that open in Cowork, and Claude usage rings.",
  "version": "0.3.1",
  "publisher": "alex-holtzman",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/handmade-kapamilya/claude-tab-queue"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeTabQueue.showQueue",
        "title": "Show Queue",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.goToSession",
        "title": "Go To Session",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.openLane",
        "title": "Open Relay Lane",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.goToTab",
        "title": "Go To Tab",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.openLaneFile",
        "title": "Open Relay Lane File",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.installHooks",
        "title": "Install Claude Code Hooks",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.clear",
        "title": "Mark All Seen",
        "category": "Claude Tab Queue",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeTabQueue.refresh",
        "title": "Refresh",
        "category": "Claude Tab Queue",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeTabQueue.openLog",
        "title": "Open Log",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.openCowork",
        "title": "Open Relay Lane in Cowork",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.popOut",
        "title": "Pop Out Board",
        "category": "Claude Tab Queue",
        "icon": "$(link-external)"
      },
      {
        "command": "claudeTabQueue.next",
        "title": "Go To What Needs You Next",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.jump",
        "title": "Jump To Tab or Lane",
        "category": "Claude Tab Queue"
      },
      {
        "command": "claudeTabQueue.toggleQuiet",
        "title": "Quiet For An Hour",
        "category": "Claude Tab Queue",
        "icon": "$(bell-slash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeTabQueue",
          "title": "Claude Queue",
          "icon": "media/queue.svg"
        }
      ]
    },
    "views": {
      "claudeTabQueue": [
        {
          "type": "webview",
          "id": "claudeTabQueue.board",
          "name": "Queue"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeTabQueue.popOut",
          "when": "view == claudeTabQueue.board",
          "group": "navigation@1"
        },
        {
          "command": "claudeTabQueue.toggleQuiet",
          "when": "view == claudeTabQueue.board",
          "group": "navigation@2"
        },
        {
          "command": "claudeTabQueue.clear",
          "when": "view == claudeTabQueue.board",
          "group": "navigation@3"
        },
        {
          "command": "claudeTabQueue.refresh",
          "when": "view == claudeTabQueue.board",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Claude Tab Queue",
      "properties": {
        "claudeTabQueue.pinMode": {
          "type": "string",
          "enum": [
            "immediate",
            "onNextSwitch",
            "off"
          ],
          "default": "immediate",
          "description": "When a session finishes or needs input, pin its tab to the front of the tab bar: right away, the next time you switch tabs, or never."
        },
        "claudeTabQueue.pinnedRow": {
          "type": "boolean",
          "default": true,
          "description": "On first run, turn on workbench.editor.pinnedTabsOnSeparateRow so queued (pinned) tabs get their own row at the top."
        },
        "claudeTabQueue.sound": {
          "type": "boolean",
          "default": true,
          "description": "Play a system sound when a session finishes, needs input, or a relay lane lands."
        },
        "claudeTabQueue.macNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show a macOS notification (via osascript) in addition to the in-window toast."
        },
        "claudeTabQueue.toast": {
          "type": "boolean",
          "default": true,
          "description": "Show an in-window toast with a Go to tab button."
        },
        "claudeTabQueue.markUnread": {
          "type": "boolean",
          "default": true,
          "description": "Also mark the finished session tab unread (orange dot) using Claude Code's own command."
        },
        "claudeTabQueue.relayLanes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/Documents/hk-relay",
            "~/Documents/hk-relay-2",
            "~/Documents/hk-relay-3"
          ],
          "description": "Relay lane folders to watch (each must contain relay/outbound.md)."
        },
        "claudeTabQueue.extraRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra folders whose Claude sessions this window should own, in addition to the workspace folders."
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeTabQueue.next",
        "key": "ctrl+cmd+u",
        "mac": "ctrl+cmd+u"
      },
      {
        "command": "claudeTabQueue.jump",
        "key": "ctrl+cmd+j",
        "mac": "ctrl+cmd+j"
      },
      {
        "command": "claudeTabQueue.toggleQuiet",
        "key": "shift+alt+cmd+j",
        "mac": "shift+alt+cmd+j"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies",
    "install-hooks": "node scripts/install-hooks.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
